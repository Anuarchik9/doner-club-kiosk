# Doner Club Republic kiosk bridge
# Update SMART_POS_HOST on-site if the terminal receives another IP address.
SMART_POS_HOST=192.168.1.8
SMART_POS_PORT=8080

# If this PC already has a valid token in %LOCALAPPDATA%\DonerClubKaspiBridge\tokens.json,
# the stored registration name is used for token refresh. For a fresh registration use:
CASH_REGISTER_NAME=DonerClubRepublic

# Listen on the Republic LAN so the iPad can open the kiosk through this PC.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765

# Cloud source for menu, stop-list, CRM and iiko order submission.
CLOUD_KIOSK_ORIGIN=https://kiosk.donerclub.kz

# Optional shared secret for the production order relay.
# Configure the same value on Render before enabling it; never commit the real value.
KIOSK_BRIDGE_ORDER_TOKEN=
